{
  "name": "csin-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "npm run build:auth && npm run build:payments && npm run build:landing",
    "build:auth": "esbuild src/auth.js --bundle --format=esm --platform=browser --outfile=public/auth.bundle.js --minify",
    "build:landing": "node scripts/build-landing.mjs",
    "build:payments": "esbuild src/payments.js --bundle --format=esm --platform=browser --outfile=public/payments.bundle.js --minify"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.27.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@solana/web3.js": "^1.99.0",
    "@tabler/icons-react": "^3.48.0",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7"
  }
}
